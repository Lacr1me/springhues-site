    {
      "id": "feature-icey-crowdfunding",
      "title": "艾希续众筹热度与开发预期管理",
      "date": "2026-10-11",
      "summary": "游民星空专栏讨论艾希续众筹超过3000万元、参与人数超过20万的现象。制作人强调作品仍是48元的小体量游戏，众筹主要用于弥补发行回款前的现金流。",
      "source": "游民星空",
      "url": "https://www.gamersky.com/news/202610/2225758.shtml",
      "image": "game-brief-assets/2026-10-12-feature-icey-crowdfunding.jpg"
    },
    {
      "id": "feature-teacon-closure",
      "title": "TeaCon闭幕节点完成，展示服务器继续开放",
      "date": "2026-10-11",
      "summary": "TeaCon 2026官网将10月11日闭幕式标为“已完成”。本届围绕联系与联结、在旧规则中创造新体验两大主题，展示服务器按日程继续开放至11月14日；具体获奖名单另待结果原文核验。",
      "source": "TeaCon 模组开发茶会",
      "url": "https://www.teacon.cn/2026",
      "image": "game-brief-assets/2026-10-12-feature-teacon-closure.jpg"
    }
  ],
