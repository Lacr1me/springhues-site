  "features": [
    {
      "id": "feature-yzll-60",
      "title": "《影之刃零》Eurogamer 打出 3/5 星，成 M 站最低分之一",
      "summary": "Eurogamer 评测给出三星及格评价，经 Metacritic 换算为 60 分；文章肯定电影化功夫打斗，但指出战斗平衡、BOSS 血量与属性提示问题，评分换算方式在玩家社区引发争论。",
      "date": "2026-10-27",
      "source": "游民星空",
      "url": "https://www.gamersky.com/news/202610/2235963.shtml",
      "image": "game-brief-assets/2026-10-28-feature-yzll-60.jpg"
    },
    {
      "id": "feature-klp-174801",
      "title": "苦力怕论坛发布《无限奥创》基岩版汉化附加包",
      "summary": "以《What If…?》无限奥创为原型的基岩版首领附加包推出汉化版，帖内给出多元宇宙首领与电影化战斗玩法说明，论坛当日有新回复讨论。",
      "date": "2026-10-27",
      "source": "苦力怕论坛",
      "url": "https://klpbbs.com/thread-174801-1-1.html",
      "image": "game-brief-assets/2026-10-28-feature-klp-174801.png"
    }
  ],
